# === Service URLs (local development) ===
TEX_SERVICE_URL=http://localhost:8001
PDF_CONVERTER_URL=http://localhost:5001
RAG_SERVICE_URL=http://localhost:8002

# === Database ===
# Local: sqlite:///./aislides.db (default if unset)
# Supabase: postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./aislides.db

# === API Keys ===
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=your-groq-key

# === Logging ===
LOGGING=INFO

# === CORS (comma-separated origins, defaults to localhost if unset) ===
# CORS_ORIGINS=https://your-app.azurestaticapps.net,http://localhost:5173

# === Storage Backend: "local", "azure", or "supabase" ===
STORAGE_BACKEND=local

# --- Azure Blob Storage (if STORAGE_BACKEND=azure) ---
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER_PRESENTATIONS=presentations
# AZURE_STORAGE_CONTAINER_RAG=rag-documents

# --- Supabase Storage (if STORAGE_BACKEND=supabase) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...your-service-role-key
# SUPABASE_STORAGE_BUCKET=presentations
