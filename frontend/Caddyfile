:80 {
  root * /srv
  encode gzip

  handle /api/* {
    reverse_proxy {$VITE_BACKEND_URL}
  }
  handle /health {
    reverse_proxy {$VITE_BACKEND_URL}
  }
  handle /generated_files/* {
    reverse_proxy {$VITE_BACKEND_URL}
  }

  # Catchall SPA fallback for TanStack Router
  handle {
    try_files {path} {path}/ /index.html
    file_server
  }
}