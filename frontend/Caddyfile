:80 {
  root * /srv
  encode gzip

  # API PROXIES FIRST (before file_server!)
  handle /api/* {
    reverse_proxy {$BACKEND_URL}
  }
  handle /health {
    reverse_proxy {$BACKEND_URL}
  }
  handle /generated_files/* {
    reverse_proxy {$BACKEND_URL}
  }

  # Static files LAST
  file_server {
    try_files {path} /index.html
  }
}