RAG_PARSER_OUTPUT_DIR=./rag_parsed
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIM=384
RAG_LLM_MODEL=llama-3.3-70b-versatile