RAG_WORKING_DIR=./rag_storage
RAG_UPLOAD_DIR=./rag_uploads
RAG_PARSER_OUTPUT_DIR=./rag_parsed

RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIM=384

RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_MIN_CHUNK_CHARS=120

RAG_PER_RETRIEVER_K=15
RAG_FINAL_CONTEXT_K=5
RAG_RRF_K=60

RAG_GROQ_API_KEY=
RAG_GROQ_MODEL=llama-3.3-70b-versatile
RAG_GROQ_CHAT_COMPLETIONS_URL=https://api.groq.com/openai/v1/chat/completions

RAG_QUERY_TIMEOUT_SECONDS=45
RAG_LLM_TIMEOUT_SECONDS=45
RAG_SYNTHESIS_MAX_CHARS=6000
RAG_GROQ_MAX_TOKENS=1024
