# Portkey Gateway (LLM routing with load balancing)
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_CONFIG_ID=your-portkey-config-id

# Embedding Provider: "huggingface" (remote API) or "fastembed" (local ONNX, recommended)
RAG_EMBEDDING_PROVIDER=fastembed

# HuggingFace Inference API (only needed if RAG_EMBEDDING_PROVIDER=huggingface)
HF_API_TOKEN=your-huggingface-token
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_DIM=384

# FastEmbed Configuration (only needed if RAG_EMBEDDING_PROVIDER=fastembed)
# RAG_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# RAG_FASTEMBED_MAX_LENGTH=512

# Storage Directories
RAG_WORKING_DIR=./rag_storage
RAG_UPLOAD_DIR=./rag_uploads
RAG_PARSER_OUTPUT_DIR=./rag_parsed

# Parser Configuration
# RAG_PARSER=docling
# RAG_PARSE_METHOD=auto
