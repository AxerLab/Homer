# Backend API URL
VITE_API_BASE_URL=http://localhost:8000

# File serving configuration
# Set to 'false' in production if files are served from CDN/cloud storage
# Set to 'true' for local development when files are in /generated_files
VITE_USE_LOCAL_FILES=true

# Example production configuration:
# VITE_API_BASE_URL=https://api.yourapp.com
# VITE_USE_LOCAL_FILES=false
# (Backend would return file_urls with CDN/S3 links in the API responses)