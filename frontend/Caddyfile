:80 {
  root * /srv
  encode gzip

  handle /api/* {
    reverse_proxy {$BACKEND_URL} {
      transport http {
        tls
        tls_insecure_skip_verify
      }
      header_up Host {upstream_hostport}
    }
  }
  handle /health {
    reverse_proxy {$BACKEND_URL} {
      transport http {
        tls
        tls_insecure_skip_verify
      }
      header_up Host {upstream_hostport}
    }
  }
  handle /generated_files/* {
    reverse_proxy {$BACKEND_URL} {
      transport http {
        tls
        tls_insecure_skip_verify
      }
      header_up Host {upstream_hostport}
    }
  }

  # Catchall SPA fallback for TanStack Router
  handle {
    try_files {path} {path}/ /index.html
    file_server
  }
}